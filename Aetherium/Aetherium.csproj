  <PropertyGroup>
    <ProfileName Condition="'$(ProfileName)' == ''">Current</ProfileName>
    <ProfileDeployDir>$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles\$(ProfileName)\BepInEx\plugins\KomradeSpectre-Aetherium</ProfileDeployDir>
  </PropertyGroup>

  <Target Name="WeaveNetworking" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <WeaverLibsDir>$(ProjectDir)$(IntermediateOutputPath)WeaverLibs</WeaverLibsDir>
    </PropertyGroup>
    <Copy SourceFiles="@(ReferencePath)" DestinationFolder="$(WeaverLibsDir)" SkipUnchangedFiles="true" />
    <Exec Command="&quot;$(ProjectDir)Weaver\Unity.UNetWeaver.exe&quot; &quot;$(WeaverLibsDir)\UnityEngine.CoreModule.dll&quot; &quot;$(WeaverLibsDir)\com.unity.multiplayer-hlapi.Runtime.dll&quot; &quot;$(TargetDir.TrimEnd('\'))&quot; &quot;$(TargetPath)&quot; &quot;$(WeaverLibsDir)&quot;" />
  </Target>

  <Target Name="DeployToProfile" AfterTargets="WeaveNetworking" Condition="Exists('$(ProfileDeployDir)')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ProfileDeployDir)" Retries="0" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="Deployed $(TargetName) to $(ProfileDeployDir)" />
  </Target>

</Project>